<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Petualangan Perkalian Ceria!</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Fredoka & Comic Neue -->
    <link href="https://fonts.googleapis.com/css2?family=Comic+Neue:wght@700&family=Fredoka:wght@400;600;700&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Canvas Confetti Library -->
    <script src="https://cdn.jsdelivr.net/ajax/libs/canvas-confetti/1.6.0/confetti.browser.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brandYellow: '#FFD166',
                        brandPink: '#EF476F',
                        brandGreen: '#06D6A0',
                        brandBlue: '#118AB2',
                        brandPurple: '#8338EC',
                        brandOrange: '#FF9F1C'
                    },
                    fontFamily: {
                        fredoka: ['Fredoka', 'sans-serif'],
                        comic: ['Comic Neue', 'cursive']
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Fredoka', sans-serif;
            background-color: #F8F9FA;
            background-image: radial-gradient(#FFD166 1.5px, transparent 1.5px), radial-gradient(#118AB2 1.5px, #F8F9FA 1.5px);
            background-size: 60px 60px;
            background-position: 0 0, 30px 30px;
            user-select: none;
            -webkit-user-select: none;
        }

        .bounce-hover:hover {
            transform: scale(1.05);
            transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .bounce-hover:active {
            transform: scale(0.95);
        }

        .card-shadow {
            box-shadow: 0 10px 0px rgba(0, 0, 0, 0.15);
        }

        .btn-shadow-pink {
            box-shadow: 0 6px 0px #C8234C;
        }
        .btn-shadow-pink:active {
            box-shadow: 0 2px 0px #C8234C;
            transform: translateY(4px);
        }

        .btn-shadow-blue {
            box-shadow: 0 6px 0px #096888;
        }
        .btn-shadow-blue:active {
            box-shadow: 0 2px 0px #096888;
            transform: translateY(4px);
        }

        .btn-shadow-green {
            box-shadow: 0 6px 0px #049A73;
        }
        .btn-shadow-green:active {
            box-shadow: 0 2px 0px #049A73;
            transform: translateY(4px);
        }

        .btn-shadow-yellow {
            box-shadow: 0 6px 0px #DDA823;
        }
        .btn-shadow-yellow:active {
            box-shadow: 0 2px 0px #DDA823;
            transform: translateY(4px);
        }

        .btn-shadow-purple {
            box-shadow: 0 6px 0px #5E17B9;
        }
        .btn-shadow-purple:active {
            box-shadow: 0 2px 0px #5E17B9;
            transform: translateY(4px);
        }

        /* Shake animation for wrong answer */
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-10px); }
            40%, 80% { transform: translateX(10px); }
        }
        .animate-shake {
            animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both;
        }

        /* Pulse animation for character */
        @keyframes happy-bounce {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-12px) rotate(3deg); }
        }
        .happy-anim {
            animation: happy-bounce 2s infinite ease-in-out;
        }

        /* Line connecting for matching game */
        svg.connecting-line {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 10;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between overflow-x-hidden text-gray-800">

    <!-- HEADER / NAV -->
    <header class="w-full bg-white/90 backdrop-blur-md border-b-4 border-brandYellow px-4 py-3 sticky top-0 z-50">
        <div class="max-w-4xl mx-auto flex justify-between items-center">
            <!-- Logo & Title -->
            <div class="flex items-center space-x-3 cursor-pointer" onclick="showMainMenu()">
                <div class="w-12 h-12 bg-brandYellow rounded-2xl flex items-center justify-center text-2xl shadow-inner happy-anim">
                    🐱
                </div>
                <div>
                    <h1 class="text-xl md:text-2xl font-bold text-brandBlue leading-none">Perkalian Ceria</h1>
                    <p class="text-xs text-gray-500 font-semibold">Kelas 3 SD • Petualangan Matematika</p>
                </div>
            </div>

            <!-- Header Controls -->
            <div class="flex items-center space-x-2">
                <button id="soundToggleBtn" onclick="toggleSound()" class="bg-gray-100 hover:bg-gray-200 text-gray-700 p-2.5 rounded-xl border-2 border-gray-300 font-bold text-sm flex items-center justify-center w-10 h-10 transition">
                    <i id="soundIcon" class="fas fa-volume-up text-brandBlue"></i>
                </button>
                <button onclick="showMainMenu()" class="bg-brandPink hover:bg-red-500 text-white font-bold px-3 py-2 rounded-xl text-xs md:text-sm shadow-md transition flex items-center gap-1.5">
                    <i class="fas fa-home"></i> Menu
                </button>
            </div>
        </div>
    </header>

    <!-- MAIN CONTAINER -->
    <main class="max-w-4xl w-full mx-auto p-4 flex-1 flex flex-col justify-center">

        <!-- ================= PAGE 1: MAIN MENU ================= -->
        <section id="menuPage" class="flex flex-col items-center text-center space-y-6 my-auto">
            <!-- Hero Banner -->
            <div class="bg-white rounded-3xl p-6 md:p-8 border-4 border-brandBlue card-shadow w-full max-w-2xl relative overflow-hidden">
                <div class="absolute -top-6 -right-6 w-24 h-24 bg-brandYellow/30 rounded-full blur-xl"></div>
                <div class="absolute -bottom-6 -left-6 w-24 h-24 bg-brandPink/30 rounded-full blur-xl"></div>

                <div class="happy-anim text-6xl mb-3">🚀</div>
                <h2 class="text-2xl md:text-4xl font-extrabold text-brandBlue mb-2">Halo Sahabat Pintar!</h2>
                <p class="text-base md:text-lg text-gray-600 mb-6">Siap belajar perkalian 1-10 sambil bermain? Pilih mode favoritmu di bawah ini!</p>

                <!-- Adventure Mode Button -->
                <button onclick="startQuiz('mixed')" class="w-full bg-brandPurple hover:bg-purple-600 text-white font-extrabold text-xl py-4 px-6 rounded-2xl btn-shadow-purple transition transform active:scale-95 flex items-center justify-center gap-3 mb-4">
                    <i class="fas fa-star text-brandYellow text-2xl animate-spin"></i>
                    <span>PETUALANGAN SERU (GABUNGAN)</span>
                    <i class="fas fa-arrow-right"></i>
                </button>
            </div>

            <!-- Specific Game Modes -->
            <div class="w-full max-w-2xl grid grid-cols-1 sm:grid-cols-2 gap-4">
                <!-- Mode Pilihan Ganda -->
                <button onclick="startQuiz('mc')" class="bg-brandBlue hover:bg-sky-600 text-white p-5 rounded-2xl btn-shadow-blue flex items-center space-x-4 transition text-left bounce-hover">
                    <div class="w-14 h-14 bg-white/20 rounded-xl flex items-center justify-center text-3xl font-black">
                        🎯
                    </div>
                    <div>
                        <h3 class="font-bold text-lg leading-snug">Pilihan Ganda</h3>
                        <p class="text-xs text-sky-100 opacity-90">Pilih 1 jawaban yang paling benar!</p>
                    </div>
                </button>

                <!-- Mode Isian Singkat -->
                <button onclick="startQuiz('sa')" class="bg-brandGreen hover:bg-emerald-600 text-white p-5 rounded-2xl btn-shadow-green flex items-center space-x-4 transition text-left bounce-hover">
                    <div class="w-14 h-14 bg-white/20 rounded-xl flex items-center justify-center text-3xl font-black">
                        ✏️
                    </div>
                    <div>
                        <h3 class="font-bold text-lg leading-snug">Isian Singkat</h3>
                        <p class="text-xs text-emerald-100 opacity-90">Ketik angka jawaban tepatmu!</p>
                    </div>
                </button>

                <!-- Mode Menjodohkan -->
                <button onclick="startQuiz('match')" class="bg-brandOrange hover:bg-orange-600 text-white p-5 rounded-2xl btn-shadow-yellow flex items-center space-x-4 transition text-left bounce-hover">
                    <div class="w-14 h-14 bg-white/20 rounded-xl flex items-center justify-center text-3xl font-black">
                        🧩
                    </div>
                    <div>
                        <h3 class="font-bold text-lg leading-snug">Menjodohkan</h3>
                        <p class="text-xs text-orange-100 opacity-90">Pasangkan soal dengan hasilnya!</p>
                    </div>
                </button>

                <!-- Mode Benar / Salah -->
                <button onclick="startQuiz('tf')" class="bg-brandPink hover:bg-rose-600 text-white p-5 rounded-2xl btn-shadow-pink flex items-center space-x-4 transition text-left bounce-hover">
                    <div class="w-14 h-14 bg-white/20 rounded-xl flex items-center justify-center text-3xl font-black">
                        👍
                    </div>
                    <div>
                        <h3 class="font-bold text-lg leading-snug">Benar / Salah</h3>
                        <p class="text-xs text-rose-100 opacity-90">Tebak apakah pernyataannya tepat!</p>
                    </div>
                </button>
            </div>
        </section>

        <!-- ================= PAGE 2: GAMEPLAY CONTAINER ================= -->
        <section id="gamePage" class="hidden flex flex-col space-y-4 my-auto w-full max-w-2xl mx-auto">
            
            <!-- Progress & Stats Header -->
            <div class="bg-white rounded-2xl p-4 border-2 border-gray-200 shadow-sm flex items-center justify-between gap-4">
                <div class="flex items-center space-x-2">
                    <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">Soal</span>
                    <span id="questionNum" class="text-lg font-black text-brandBlue">1/5</span>
                </div>

                <!-- Progress Bar -->
                <div class="flex-1 bg-gray-200 h-4 rounded-full overflow-hidden p-0.5 border border-gray-300">
                    <div id="progressBar" class="bg-brandGreen h-full rounded-full transition-all duration-300" style="width: 20%;"></div>
                </div>

                <div class="flex items-center space-x-1 text-brandYellow font-black text-lg">
                    <i class="fas fa-star"></i>
                    <span id="currentScore" class="text-gray-700">0</span>
                </div>
            </div>

            <!-- Quiz Card -->
            <div id="quizCard" class="bg-white rounded-3xl p-6 md:p-8 border-4 border-brandBlue card-shadow relative">
                
                <!-- Question Type Tag -->
                <div class="flex justify-between items-center mb-4">
                    <span id="modeBadge" class="bg-brandYellow/20 text-yellow-800 text-xs font-bold px-3 py-1 rounded-full border border-brandYellow/40">
                        Pilihan Ganda
                    </span>
                    <span id="helperMsg" class="text-xs text-gray-400 font-semibold">Pilih jawabanmu!</span>
                </div>

                <!-- MAIN QUESTION TEXT -->
                <div class="text-center py-4">
                    <div id="questionText" class="text-4xl md:text-6xl font-black text-brandBlue tracking-wide">
                        6 x 7 = ... ?
                    </div>
                    <p id="subQuestionText" class="text-gray-500 font-medium text-sm mt-2 hidden"></p>
                </div>

                <!-- DYNAMIC ANSWER INTERACTION AREA -->
                <div id="answerArea" class="mt-6">
                    <!-- Dynamic Content Inserted by JS -->
                </div>

                <!-- Feedback Toast Banner -->
                <div id="feedbackBanner" class="hidden mt-4 p-4 rounded-2xl text-center font-bold text-lg flex items-center justify-center gap-3">
                    <span id="feedbackIcon" class="text-2xl"></span>
                    <span id="feedbackText"></span>
                </div>
            </div>

            <!-- Bottom Control / Next Button -->
            <div class="flex justify-end">
                <button id="nextBtn" onclick="nextQuestion()" class="hidden bg-brandGreen hover:bg-emerald-600 text-white font-extrabold text-lg py-3 px-8 rounded-2xl btn-shadow-green transition items-center gap-2">
                    <span>Soal Berikutnya</span>
                    <i class="fas fa-arrow-right"></i>
                </button>
            </div>
        </section>

        <!-- ================= PAGE 3: RESULT SCORE ================= -->
        <section id="resultPage" class="hidden flex flex-col items-center text-center space-y-6 my-auto">
            <div class="bg-white rounded-3xl p-8 border-4 border-brandYellow card-shadow w-full max-w-lg relative overflow-hidden">
                <div class="text-5xl mb-2 happy-anim" id="resultEmoji">🏆</div>
                <h2 class="text-3xl font-black text-brandBlue mb-1">Hebat Sekali!</h2>
                <p class="text-gray-500 font-semibold mb-6">Kamu telah menyelesaikan latihan ini!</p>

                <!-- Stars Container -->
                <div class="flex justify-center items-center gap-2 mb-6" id="starsContainer">
                    <i class="fas fa-star text-4xl text-gray-300"></i>
                    <i class="fas fa-star text-5xl text-gray-300"></i>
                    <i class="fas fa-star text-4xl text-gray-300"></i>
                </div>

                <!-- Score Box -->
                <div class="bg-yellow-50 border-2 border-brandYellow rounded-2xl p-4 mb-6">
                    <p class="text-xs text-gray-500 font-bold uppercase tracking-wider mb-1">Skor Akhir Kamu</p>
                    <div class="text-5xl font-black text-brandOrange" id="finalScoreText">100</div>
                    <p class="text-sm font-semibold text-gray-600 mt-2" id="scoreDetailsText">Benar 5 dari 5 soal!</p>
                </div>

                <!-- Encouragement Message -->
                <p id="encouragementText" class="text-base font-bold text-brandPurple mb-6">
                    Luar biasa! Kamu adalah Juara Perkalian! 🌟
                </p>

                <!-- Action Buttons -->
                <div class="flex flex-col sm:flex-row gap-3">
                    <button onclick="retryQuiz()" class="flex-1 bg-brandBlue hover:bg-sky-600 text-white font-bold py-3.5 px-4 rounded-xl btn-shadow-blue transition flex items-center justify-center gap-2">
                        <i class="fas fa-redo"></i> Coba Lagi
                    </button>
                    <button onclick="showMainMenu()" class="flex-1 bg-brandGreen hover:bg-emerald-600 text-white font-bold py-3.5 px-4 rounded-xl btn-shadow-green transition flex items-center justify-center gap-2">
                        <i class="fas fa-home"></i> Menu Utama
                    </button>
                </div>
            </div>
        </section>

    </main>

    <!-- FOOTER -->
    <footer class="w-full text-center py-4 text-xs font-semibold text-gray-400">
        Petualangan Perkalian Ceria • Dibuat khusus untuk Belajar Matematika SD 🎈
    </footer>

    <!-- JAVASCRIPT LOGIC -->
    <script>
        /* ================= STATE MANAGEMENT ================= */
        let currentMode = 'mc'; // 'mc', 'sa', 'match', 'tf', 'mixed'
        let currentQuestions = [];
        let currentIndex = 0;
        let score = 0;
        let soundEnabled = true;
        let selectedMatchPair = { left: null, right: null };
        let matchedCount = 0;
        let isAnswered = false;

        // Web Audio API for synthetic sound effects without external files
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

        function playSound(type) {
            if (!soundEnabled) return;
            try {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.connect(gain);
                gain.connect(audioCtx.destination);

                const now = audioCtx.currentTime;

                if (type === 'correct') {
                    // Happy ding-ding chord
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(523.25, now); // C5
                    osc.frequency.exponentialRampToValueAtTime(659.25, now + 0.1); // E5
                    osc.frequency.exponentialRampToValueAtTime(783.99, now + 0.2); // G5
                    gain.gain.setValueAtTime(0.3, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.4);
                    osc.start(now);
                    osc.stop(now + 0.4);
                } else if (type === 'wrong') {
                    // Low buzz
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(180, now);
                    osc.frequency.linearRampToValueAtTime(110, now + 0.25);
                    gain.gain.setValueAtTime(0.2, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3);
                    osc.start(now);
                    osc.stop(now + 0.3);
                } else if (type === 'click') {
                    // Soft pop
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(400, now);
                    osc.frequency.exponentialRampToValueAtTime(200, now + 0.05);
                    gain.gain.setValueAtTime(0.1, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.05);
                    osc.start(now);
                    osc.stop(now + 0.05);
                } else if (type === 'fanfare') {
                    // Celebration fanfare
                    [523.25, 659.25, 783.99, 1046.50].forEach((freq, idx) => {
                        const o = audioCtx.createOscillator();
                        const g = audioCtx.createGain();
                        o.connect(g);
                        g.connect(audioCtx.destination);
                        o.frequency.value = freq;
                        g.gain.setValueAtTime(0.2, now + idx * 0.1);
                        g.gain.exponentialRampToValueAtTime(0.01, now + idx * 0.1 + 0.3);
                        o.start(now + idx * 0.1);
                        o.stop(now + idx * 0.1 + 0.3);
                    });
                }
            } catch (e) {
                console.log("Audio play error:", e);
            }
        }

        function toggleSound() {
            soundEnabled = !soundEnabled;
            const icon = document.getElementById('soundIcon');
            if (soundEnabled) {
                icon.className = 'fas fa-volume-up text-brandBlue';
            } else {
                icon.className = 'fas fa-volume-mute text-gray-400';
            }
        }

        /* ================= QUESTION GENERATORS ================= */
        // Random integer helper
        function getRandomInt(min, max) {
            return Math.floor(Math.random() * (max - min + 1)) + min;
        }

        // Generate a set of 5 questions based on mode
        function generateQuiz(mode) {
            const questions = [];
            const modesPool = ['mc', 'sa', 'match', 'tf'];

            for (let i = 0; i < 5; i++) {
                let actualMode = mode === 'mixed' ? modesPool[Math.floor(Math.random() * modesPool.length)] : mode;
                
                let num1 = getRandomInt(1, 10);
                let num2 = getRandomInt(1, 10);
                let correctAns = num1 * num2;

                if (actualMode === 'mc') {
                    // Multiple Choice
                    let options = new Set([correctAns]);
                    while (options.size < 4) {
                        let wrong = correctAns + getRandomInt(-5, 5);
                        if (wrong > 0 && wrong !== correctAns) options.add(wrong);
                    }
                    questions.push({
                        type: 'mc',
                        num1, num2,
                        answer: correctAns,
                        options: Array.from(options).sort(() => Math.random() - 0.5)
                    });
                } else if (actualMode === 'sa') {
                    // Short Answer
                    questions.push({
                        type: 'sa',
                        num1, num2,
                        answer: correctAns
                    });
                } else if (actualMode === 'tf') {
                    // True or False
                    const isTrue = Math.random() > 0.5;
                    let displayedAns = isTrue ? correctAns : correctAns + (Math.random() > 0.5 ? getRandomInt(1, 4) : -getRandomInt(1, 4));
                    if (displayedAns <= 0) displayedAns = correctAns + 2;

                    questions.push({
                        type: 'tf',
                        num1, num2,
                        displayedAns,
                        answer: isTrue || displayedAns === correctAns
                    });
                } else if (actualMode === 'match') {
                    // Matching Mode (3 mini questions inside 1 slide)
                    let pairs = [];
                    let usedNumbers = new Set();
                    while (pairs.length < 3) {
                        let n1 = getRandomInt(2, 9);
                        let n2 = getRandomInt(2, 9);
                        let prod = n1 * n2;
                        if (!usedNumbers.has(prod)) {
                            usedNumbers.add(prod);
                            pairs.push({ q: `${n1} x ${n2}`, a: prod, id: pairs.length });
                        }
                    }
                    questions.push({
                        type: 'match',
                        pairs: pairs
                    });
                }
            }
            return questions;
        }

        /* ================= PAGE NAVIGATION ================= */
        function showMainMenu() {
            playSound('click');
            document.getElementById('menuPage').classList.remove('hidden');
            document.getElementById('gamePage').classList.add('hidden');
            document.getElementById('resultPage').classList.add('hidden');
        }

        function startQuiz(mode) {
            playSound('click');
            currentMode = mode;
            currentQuestions = generateQuiz(mode);
            currentIndex = 0;
            score = 0;
            
            document.getElementById('currentScore').innerText = score;
            document.getElementById('menuPage').classList.add('hidden');
            document.getElementById('resultPage').classList.add('hidden');
            document.getElementById('gamePage').classList.remove('hidden');

            renderQuestion();
        }

        function retryQuiz() {
            startQuiz(currentMode);
        }

        /* ================= RENDER QUESTION ================= */
        function renderQuestion() {
            isAnswered = false;
            const q = currentQuestions[currentIndex];
            const answerArea = document.getElementById('answerArea');
            const nextBtn = document.getElementById('nextBtn');
            const feedbackBanner = document.getElementById('feedbackBanner');
            const subText = document.getElementById('subQuestionText');
            
            // Reset state UI
            nextBtn.classList.add('hidden');
            feedbackBanner.classList.add('hidden');
            subText.classList.add('hidden');
            answerArea.innerHTML = '';

            // Update Progress Header
            document.getElementById('questionNum').innerText = `${currentIndex + 1}/${currentQuestions.length}`;
            document.getElementById('progressBar').style.width = `${((currentIndex + 1) / currentQuestions.length) * 100}%`;

            // Badge text & Main Question Render
            const modeBadge = document.getElementById('modeBadge');
            const helperMsg = document.getElementById('helperMsg');

            if (q.type === 'mc') {
                modeBadge.innerText = '🎯 Pilihan Ganda';
                helperMsg.innerText = 'Klik 1 jawaban yang tepat!';
                document.getElementById('questionText').innerText = `${q.num1} × ${q.num2} = ...`;

                let grid = document.createElement('div');
                grid.className = 'grid grid-cols-2 gap-4 mt-4';

                q.options.forEach(opt => {
                    let btn = document.createElement('button');
                    btn.className = 'bg-gray-100 hover:bg-brandBlue/10 border-3 border-gray-300 hover:border-brandBlue rounded-2xl py-4 text-2xl md:text-3xl font-black text-gray-800 transition transform bounce-hover btn-opt';
                    btn.innerText = opt;
                    btn.onclick = () => checkAnswerMC(opt, q.answer, btn);
                    grid.appendChild(btn);
                });
                answerArea.appendChild(grid);

            } else if (q.type === 'sa') {
                modeBadge.innerText = '✏️ Isian Singkat';
                helperMsg.innerText = 'Ketik angka jawabanmu di bawah!';
                document.getElementById('questionText').innerText = `${q.num1} × ${q.num2} = ...`;

                let container = document.createElement('div');
                container.className = 'flex flex-col items-center gap-4 mt-2';
                
                container.innerHTML = `
                    <input type="number" id="shortAnswerInput" inputmode="numeric" placeholder="?" class="w-36 text-center text-4xl font-black p-3 border-4 border-brandBlue rounded-2xl focus:outline-none focus:ring-4 focus:ring-brandYellow/50 shadow-inner" autofocus />
                    <button onclick="checkAnswerSA(${q.answer})" class="bg-brandGreen hover:bg-emerald-600 text-white font-extrabold text-lg px-8 py-3 rounded-2xl btn-shadow-green transition bounce-hover">
                        Kirim Jawaban <i class="fas fa-check ml-1"></i>
                    </button>
                `;
                answerArea.appendChild(container);

                // Auto focus and enter key event
                setTimeout(() => {
                    const input = document.getElementById('shortAnswerInput');
                    if (input) {
                        input.focus();
                        input.addEventListener('keyup', (e) => {
                            if (e.key === 'Enter') checkAnswerSA(q.answer);
                        });
                    }
                }, 100);

            } else if (q.type === 'tf') {
                modeBadge.innerText = '👍 Benar / Salah';
                helperMsg.innerText = 'Apakah hasil perkalian ini benar?';
                document.getElementById('questionText').innerText = `${q.num1} × ${q.num2} = ${q.displayedAns}`;

                let grid = document.createElement('div');
                grid.className = 'grid grid-cols-2 gap-4 mt-6';

                let btnTrue = document.createElement('button');
                btnTrue.className = 'bg-emerald-100 hover:bg-emerald-200 border-4 border-brandGreen text-emerald-800 rounded-2xl py-4 text-2xl font-black transition bounce-hover flex items-center justify-center gap-2';
                btnTrue.innerHTML = '<i class="fas fa-thumbs-up"></i> BENAR';
                btnTrue.onclick = () => checkAnswerTF(true, q.answer, btnTrue);

                let btnFalse = document.createElement('button');
                btnFalse.className = 'bg-rose-100 hover:bg-rose-200 border-4 border-brandPink text-rose-800 rounded-2xl py-4 text-2xl font-black transition bounce-hover flex items-center justify-center gap-2';
                btnFalse.innerHTML = '<i class="fas fa-thumbs-down"></i> SALAH';
                btnFalse.onclick = () => checkAnswerTF(false, q.answer, btnFalse);

                grid.appendChild(btnTrue);
                grid.appendChild(btnFalse);
                answerArea.appendChild(grid);

            } else if (q.type === 'match') {
                modeBadge.innerText = '🧩 Menjodohkan';
                helperMsg.innerText = 'Klik Soal lalu klik Hasil yang cocok!';
                document.getElementById('questionText').innerText = 'Jodohkan Pasangan!';
                subText.innerText = 'Klik pertanyaan di kiri, lalu klik jawaban yang sesuai di kanan!';
                subText.classList.remove('hidden');

                selectedMatchPair = { left: null, right: null };
                matchedCount = 0;

                let leftItems = [...q.pairs];
                let rightItems = [...q.pairs].map(p => ({ a: p.a, id: p.id })).sort(() => Math.random() - 0.5);

                let container = document.createElement('div');
                container.className = 'grid grid-cols-2 gap-4 md:gap-8 mt-4 relative';

                let leftCol = document.createElement('div');
                leftCol.className = 'flex flex-col gap-3';
                leftItems.forEach(item => {
                    let b = document.createElement('button');
                    b.className = 'bg-blue-50 border-3 border-brandBlue text-brandBlue font-black text-xl py-3 rounded-2xl transition match-left shadow-sm hover:bg-blue-100';
                    b.innerText = item.q;
                    b.dataset.id = item.id;
                    b.onclick = () => selectMatchLeft(b);
                    leftCol.appendChild(b);
                });

                let rightCol = document.createElement('div');
                rightCol.className = 'flex flex-col gap-3';
                rightItems.forEach(item => {
                    let b = document.createElement('button');
                    b.className = 'bg-purple-50 border-3 border-brandPurple text-brandPurple font-black text-xl py-3 rounded-2xl transition match-right shadow-sm hover:bg-purple-100';
                    b.innerText = item.a;
                    b.dataset.id = item.id;
                    b.onclick = () => selectMatchRight(b, q.pairs.length);
                    rightCol.appendChild(b);
                });

                container.appendChild(leftCol);
                container.appendChild(rightCol);
                answerArea.appendChild(container);
            }
        }

        /* ================= ANSWER CHECKERS ================= */

        // Show feedback banner
        function showFeedback(isCorrect, text) {
            const banner = document.getElementById('feedbackBanner');
            const icon = document.getElementById('feedbackIcon');
            const txt = document.getElementById('feedbackText');
            
            banner.classList.remove('hidden', 'bg-emerald-100', 'text-emerald-800', 'border-brandGreen', 'bg-rose-100', 'text-rose-800', 'border-brandPink');
            banner.classList.add('border-2');

            if (isCorrect) {
                banner.classList.add('bg-emerald-100', 'text-emerald-800', 'border-brandGreen');
                icon.innerText = '🎉';
                txt.innerText = text || 'Hebat! Jawabanmu Benar!';
                playSound('correct');
                confetti({ particleCount: 40, spread: 60, origin: { y: 0.7 } });
            } else {
                banner.classList.add('bg-rose-100', 'text-rose-800', 'border-brandPink');
                icon.innerText = '💡';
                txt.innerText = text || 'Ups, kurang tepat! Tetap semangat!';
                playSound('wrong');

                // Shake quiz card
                const card = document.getElementById('quizCard');
                card.classList.add('animate-shake');
                setTimeout(() => card.classList.remove('animate-shake'), 500);
            }

            document.getElementById('nextBtn').classList.remove('hidden');
        }

        // 1. Check Multiple Choice
        function checkAnswerMC(selected, correct, btnEl) {
            if (isAnswered) return;
            isAnswered = true;

            const buttons = document.querySelectorAll('.btn-opt');
            buttons.forEach(btn => btn.disabled = true);

            if (selected === correct) {
                btnEl.classList.remove('bg-gray-100');
                btnEl.classList.add('bg-emerald-500', 'text-white', 'border-emerald-600');
                score += 20;
                document.getElementById('currentScore').innerText = score;
                showFeedback(true, `Pintar! ${selected} adalah jawaban benar!`);
            } else {
                btnEl.classList.remove('bg-gray-100');
                btnEl.classList.add('bg-rose-500', 'text-white', 'border-rose-600');
                
                // Highlight correct one
                buttons.forEach(btn => {
                    if (parseInt(btn.innerText) === correct) {
                        btn.classList.add('bg-emerald-400', 'text-white', 'border-emerald-500');
                    }
                });
                showFeedback(false, `Jawaban tepatnya adalah ${correct}`);
            }
        }

        // 2. Check Short Answer
        function checkAnswerSA(correct) {
            if (isAnswered) return;
            const input = document.getElementById('shortAnswerInput');
            if (!input || input.value.trim() === '') return;

            isAnswered = true;
            input.disabled = true;
            const val = parseInt(input.value.trim());

            if (val === correct) {
                input.classList.add('bg-emerald-100', 'border-brandGreen', 'text-brandGreen');
                score += 20;
                document.getElementById('currentScore').innerText = score;
                showFeedback(true, `Luar Biasa! Jawaban ${val} Tepat!`);
            } else {
                input.classList.add('bg-rose-100', 'border-brandPink', 'text-brandPink');
                showFeedback(false, `Jawaban yang benar adalah ${correct}`);
            }
        }

        // 3. Check True/False
        function checkAnswerTF(userChoice, actualCorrectBool, btnEl) {
            if (isAnswered) return;
            isAnswered = true;

            if (userChoice === actualCorrectBool) {
                score += 20;
                document.getElementById('currentScore').innerText = score;
                showFeedback(true, 'Tepat Sekali! Analisis kamu benar!');
            } else {
                showFeedback(false, actualCorrectBool ? 'Seharusnya BENAR ya!' : 'Seharusnya SALAH ya!');
            }
        }

        // 4. Matching Logic
        function selectMatchLeft(btn) {
            if (btn.classList.contains('matched')) return;
            playSound('click');

            document.querySelectorAll('.match-left').forEach(b => {
                if (!b.classList.contains('matched')) {
                    b.classList.remove('bg-brandYellow', 'text-gray-900', 'border-yellow-500');
                    b.classList.add('bg-blue-50', 'text-brandBlue');
                }
            });

            btn.classList.remove('bg-blue-50', 'text-brandBlue');
            btn.classList.add('bg-brandYellow', 'text-gray-900', 'border-yellow-500');
            selectedMatchPair.left = btn;
        }

        function selectMatchRight(btn, totalPairs) {
            if (btn.classList.contains('matched') || !selectedMatchPair.left) return;
            playSound('click');

            selectedMatchPair.right = btn;
            const leftId = selectedMatchPair.left.dataset.id;
            const rightId = selectedMatchPair.right.dataset.id;

            if (leftId === rightId) {
                // Correct Match
                playSound('correct');
                selectedMatchPair.left.classList.remove('bg-brandYellow', 'text-gray-900', 'border-yellow-500', 'bg-blue-50');
                selectedMatchPair.left.classList.add('bg-emerald-500', 'text-white', 'border-emerald-600', 'matched');
                
                selectedMatchPair.right.classList.remove('bg-purple-50', 'text-brandPurple');
                selectedMatchPair.right.classList.add('bg-emerald-500', 'text-white', 'border-emerald-600', 'matched');

                selectedMatchPair.left.disabled = true;
                selectedMatchPair.right.disabled = true;
                
                selectedMatchPair = { left: null, right: null };
                matchedCount++;

                if (matchedCount === totalPairs) {
                    isAnswered = true;
                    score += 20;
                    document.getElementById('currentScore').innerText = score;
                    showFeedback(true, 'Keren! Semua pasangan berhasil dijodohkan!');
                }
            } else {
                // Wrong Match
                playSound('wrong');
                const leftBtn = selectedMatchPair.left;
                const rightBtn = selectedMatchPair.right;

                leftBtn.classList.add('bg-rose-400', 'text-white');
                rightBtn.classList.add('bg-rose-400', 'text-white');

                setTimeout(() => {
                    leftBtn.classList.remove('bg-rose-400', 'text-white', 'bg-brandYellow', 'border-yellow-500');
                    leftBtn.classList.add('bg-blue-50', 'text-brandBlue');
                    rightBtn.classList.remove('bg-rose-400', 'text-white');
                    rightBtn.classList.add('bg-purple-50', 'text-brandPurple');
                }, 600);

                selectedMatchPair = { left: null, right: null };
            }
        }

        /* ================= NEXT QUESTION & END GAME ================= */
        function nextQuestion() {
            playSound('click');
            currentIndex++;

            if (currentIndex < currentQuestions.length) {
                renderQuestion();
            } else {
                showResults();
            }
        }

        function showResults() {
            document.getElementById('gamePage').classList.add('hidden');
            document.getElementById('resultPage').classList.remove('hidden');

            const finalScoreText = document.getElementById('finalScoreText');
            const scoreDetailsText = document.getElementById('scoreDetailsText');
            const starsContainer = document.getElementById('starsContainer');
            const encouragementText = document.getElementById('encouragementText');
            const resultEmoji = document.getElementById('resultEmoji');

            finalScoreText.innerText = score;
            const correctCount = score / 20;
            scoreDetailsText.innerText = `Kamu berhasil menjawab benar ${correctCount} dari 5 soal!`;

            // Calculate Stars
            let starsHTML = '';
            if (score === 100) {
                starsHTML = `
                    <i class="fas fa-star text-5xl text-brandYellow animate-bounce"></i>
                    <i class="fas fa-star text-6xl text-brandYellow animate-bounce" style="animation-delay: 0.1s;"></i>
                    <i class="fas fa-star text-5xl text-brandYellow animate-bounce" style="animation-delay: 0.2s;"></i>
                `;
                encouragementText.innerText = 'Sempurna! Kamu adalah Sang Master Perkalian! 🏆✨';
                resultEmoji.innerText = '👑';
                playSound('fanfare');
                confetti({ particleCount: 100, spread: 80, origin: { y: 0.6 } });
            } else if (score >= 60) {
                starsHTML = `
                    <i class="fas fa-star text-5xl text-brandYellow"></i>
                    <i class="fas fa-star text-6xl text-brandYellow"></i>
                    <i class="fas fa-star text-5xl text-gray-300"></i>
                `;
                encouragementText.innerText = 'Bagus Sekali! Tingkatkan terus latihannya ya! 🌟';
                resultEmoji.innerText = '🎉';
                playSound('correct');
            } else {
                starsHTML = `
                    <i class="fas fa-star text-5xl text-brandYellow"></i>
                    <i class="fas fa-star text-5xl text-gray-300"></i>
                    <i class="fas fa-star text-5xl text-gray-300"></i>
                `;
                encouragementText.innerText = 'Jangan menyerah! Coba lagi dan kamu pasti bisa! 💪';
                resultEmoji.innerText = '🐥';
            }
            starsContainer.innerHTML = starsHTML;
        }

        // Audio context initializer for mobile browsers on first interaction
        document.addEventListener('click', function initAudio() {
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
            document.removeEventListener('click', initAudio);
        });
    </script>
</body>
</html>
